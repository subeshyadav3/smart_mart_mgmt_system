generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  password      String
  phoneNumber   String?
  role          Role           @default(STAFF)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBills  Bill[]
  inventoryLogs InventoryLog[]
}

model Member {
  id            String   @id @default(uuid())
  membershipId  String   @unique
  fullName      String
  phoneNumber   String   @unique
  loyaltyPoints Int      @default(0)
  totalSpent    Decimal  @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bills         Bill[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id              String         @id @default(uuid())
  name            String
  sku             String         @unique
  barcode         String?        @unique
  description     String?
  imageUrl        String?
  buyingPrice     Decimal
  sellingPrice    Decimal
  discountPercent Float          @default(0)
  stockQuantity   Int            @default(0)
  minimumStock    Int            @default(5)
  status          ProductStatus  @default(ACTIVE)
  categoryId      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  billItems       BillItem[]
  inventoryLogs   InventoryLog[]
  category        Category       @relation(fields: [categoryId], references: [id])
}

model InventoryLog {
  id            String   @id @default(uuid())
  productId     String
  updatedById   String
  previousStock Int
  newStock      Int
  changeAmount  Int
  reason        String
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id])
  updatedBy     Staff    @relation(fields: [updatedById], references: [id])
}

model Bill {
  id            String        @id @default(uuid())
  billNumber    String        @unique
  createdById   String
  memberId      String?
  subtotal      Decimal
  totalDiscount Decimal       @default(0)
  finalAmount   Decimal
  status        BillStatus    @default(COMPLETED)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  createdBy     Staff         @relation(fields: [createdById], references: [id])
  member        Member?       @relation(fields: [memberId], references: [id])
  billItems     BillItem[]
}

model BillItem {
  id              String   @id @default(uuid())
  billId          String
  productId       String
  quantity        Int
  productPrice    Decimal
  discountPercent Float    @default(0)
  totalPrice      Decimal
  createdAt       DateTime @default(now())
  bill            Bill     @relation(fields: [billId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
}

enum Role {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum BillStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_WALLET
}
